<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-light">
  <%= link_to "ALPHA BLOG", root_path,
              class: "navbar-brand fw-bold text-white",
              id: "logo" %>

  <button class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarSupportedContent">

    <!-- Left Side -->
    <ul class="navbar-nav me-auto">

      <li class="nav-item">
        <%= link_to "Bloggers",
                    users_path,
                    class: "nav-link text-white" %>
      </li>

      <!-- Articles Dropdown -->
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-white"
           href="#"
           id="articlesDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
          Articles
        </a>

        <ul class="dropdown-menu bg-dark border-light">

          <% if logged_in? %>
            <li>
              <%= link_to "Create new article",
                          new_article_path,
                          class: "dropdown-item text-white bg-dark" %>
            </li>
          <% end %>

          <li>
            <%= link_to "View articles",
                        articles_path,
                        class: "dropdown-item text-white bg-dark" %>
          </li>

          <li><hr class="dropdown-divider bg-light"></li>

          <li>
            <a class="dropdown-item text-white bg-dark" href="#">
              Something else here
            </a>
          </li>
        </ul>
      </li>

      <% if logged_in? %>

        <!-- Profile Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle text-white fw-semibold"
             href="#"
             id="profileDropdown"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <%= "(Admin)"if current_user.admin? %> Profile [<%= current_user.username %>]
          </a>

          <ul class="dropdown-menu bg-dark border-light">

            <li>
              <%= link_to "View your profile",
                          user_path(current_user),
                          class: "dropdown-item text-white bg-dark" %>
            </li>

            <li>
              <%= link_to "Edit your profile",
                          edit_user_path(current_user),
                          class: "dropdown-item text-white bg-dark" %>
            </li>

            <li>
              <%= link_to "Delete profile",
                          user_path(current_user),
                          class: "dropdown-item text-danger",
                          method: :delete,
                          data: { confirm: "Are you sure?" } %>
            </li>

          </ul>
        </li>

        <!-- Logout -->
        <li class="nav-item">
          <%= button_to "Logout",
                        logout_path,
                        method: :delete,
                        form: { data: { turbo: false }, style: "display:inline;" },
                        class: "btn btn-link nav-link text-white p-0" %>
        </li>

      <% else %>

        <li class="nav-item">
          <%= link_to "Log in",
                      login_path,
                      class: "nav-link text-white" %>
        </li>

        <li class="nav-item">
          <%= link_to "Sign Up",
                      signup_path,
                      class: "nav-link text-white" %>
        </li>

      <% end %>

    </ul>

    <!-- Right Side -->
    <form class="d-flex">
      <input class="form-control me-2 bg-dark text-white border-light"
             type="search"
             placeholder="Search"
             aria-label="Search">
      <button class="btn btn-outline-light"
              type="submit">
        Search
      </button>
    </form>

  </div>
</nav>
